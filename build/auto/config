#!/bin/sh
set -e

lb config noauto \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootloaders grub-efi \
    --uefi-secure-boot disable \
    --debian-installer none \
    --memtest none \
    --iso-application "Linux Tahoe" \
    --iso-publisher "Linux Tahoe Project" \
    --iso-volume "LinuxTahoe-1.0" \
    --bootappend-live "boot=live components splash quiet loglevel=0" \
    --apt-recommends false \
    "${@}"
